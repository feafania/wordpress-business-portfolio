{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "text", "name": "Text", "color": "#0f172a" },
        { "slug": "background", "name": "Background", "color": "#ffffff" },
        { "slug": "primary", "name": "Primary", "color": "#1d4ed8" },
        { "slug": "primary-dark", "name": "Primary Dark", "color": "#1e3a8a" },
        { "slug": "muted", "name": "Muted", "color": "#475569" },
        { "slug": "border", "name": "Border", "color": "#e2e8f0" },
        { "slug": "dark", "name": "Dark", "color": "#0f172a" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1rem" },
        { "slug": "medium", "name": "Medium", "size": "1.25rem" },
        { "slug": "large", "name": "Large", "size": "2rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "2.75rem" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%" ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.3" } }
    }
  }
}